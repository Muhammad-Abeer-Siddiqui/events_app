{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "events": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('email').val() === 'abeersiddiki2k18@gmail.com'",
        "goingCount": {
          ".write": "auth != null"
        },
        "interestedCount": {
          ".write": "auth != null"
        }
      }
    },
    "eventRequests": {
      ".read": "auth != null",
      ".indexOn": [
        "status"
      ],
      "$requestId": {
        ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('email').val() === 'abeersiddiki2k18@gmail.com')"
      }
    },
    "userEvents": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "globalMessages": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$messageId": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.child('senderId').val() === auth.uid"
      }
    },
    "eventChats": {
      "$eventId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          "$messageId": {
            ".validate": "newData.child('senderId').val() === auth.uid"
          }
        }
      }
    },
    "privateChats": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        ".write": "auth != null && $chatId.contains(auth.uid)",
        "messages": {
          "$messageId": {
            ".validate": "newData.child('senderId').val() === auth.uid"
          }
        }
      }
    },
    "following": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}